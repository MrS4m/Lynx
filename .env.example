# Copie para .env e ajuste:  cp .env.example .env

# Segredo que os agentes usam para enviar dados. Gere um com:  openssl rand -hex 24
TOKEN=troque-por-um-segredo-longo

# Porta publicada no servidor. Use 80 para acessar sem ":porta" (ex.: http://monitor.lan)
PORT=8080

# Login do painel (recomendado). Se DASH_USER ficar vazio, o painel abre sem senha.
DASH_USER=admin
DASH_PASS=troque-esta-senha

# Opcional: chave para exibir o MODO TV sem login (TV de parede). Somente leitura do resumo.
# Acesso: http://monitor.lan:8080/?key=SUA_CHAVE#/tv    Gere com:  openssl rand -hex 16
TV_KEY=

# Opcional: avisos em Slack, Discord ou Mattermost (URL do webhook de entrada)
WEBHOOK_URL=

TZ=America/Sao_Paulo
